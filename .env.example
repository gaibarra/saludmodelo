# Generate a unique secret; no default passwords or public accounts.
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=salud.example.org
CSRF_TRUSTED_ORIGINS=https://salud.example.org
PGDATABASE=salud_modelo
PGUSER=salud_modelo
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PRIVATE_STORAGE=/var/lib/salud-modelo/private
BACKEND_URL=http://127.0.0.1:8000
# Server-only credentials. External calls remain disabled until configured and authorized.
AI_EXTERNAL_ENABLED=0
AI_MODELS_JSON={}
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Dedicated, current ClamAV signatures. No system service is changed by the app.
DOCUMENT_SIGNATURES=
DOCUMENT_SCAN_CERTIFICATES=/etc/clamav/certs
# Optional private runtime produced by python3 deploy/prepare_ocr.py
DOCUMENT_OCR_RUNTIME=

# Separate private Fernet key, required before privileged sign-in. Keep outside DB backups.
MFA_ENCRYPTION_KEY=
MFA_REQUIRE_PRIVILEGED=1

# Enable only after institutional identity-verification and secure-delivery agreement.
EXCEPTIONAL_MFA_RECOVERY_ENABLED=0
