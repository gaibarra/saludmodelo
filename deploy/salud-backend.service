[Unit]
Description=Salud Modelo backend
After=network.target
[Service]
Type=simple
User=salud-modelo
Group=salud-modelo
WorkingDirectory=/opt/salud-modelo/backend
EnvironmentFile=/etc/salud-modelo.env
ExecStart=/opt/salud-modelo/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/salud-modelo /opt/salud-modelo/frontend/.next
[Install]
WantedBy=multi-user.target
